# Chép thành .env.local khi chạy máy cá nhân. Không commit .env.local.

# Bắt buộc khi chạy production / deploy (chuỗi ngẫu nhiên dài)
SESSION_SECRET=

# Khoá cho hệ thống ngoài gọi /api/integrations/* (header x-api-key)
INTEGRATION_API_KEY=

# Đường dẫn file SQLite. Máy cá nhân: ./data/sms.db. Deploy: /data/sms.db (thư mục volume). Test: :memory:
SMS_DB_PATH=./data/sms.db

# Agent: mock (luật cứng, không cần key, không tốn tiền). Bỏ trống thì dùng mô hình thật khi có API key.
SMS_AI_MODE=mock

# Nhà cung cấp mô hình (DEC-12): openai (chốt, WP-08 viết adapter) hoặc claude (adapter cũ)
LLM_PROVIDER=openai

# Khoá của nhà cung cấp đang dùng
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
